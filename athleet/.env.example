# Server-only (no EXPO_PUBLIC_ prefix) — read by the API routes in src/app/api/voice,
# never bundled into the app. Get a key at elevenlabs.io → Profile → API keys.
ELEVENLABS_API_KEY=

# Optional
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Shared secret the app must send; set both or neither.
# VOICE_API_KEY=
# EXPO_PUBLIC_VOICE_API_KEY=
# Only for a production build hosted elsewhere (dev finds the server automatically):
# EXPO_PUBLIC_VOICE_API_URL=https://your-app.expo.app
